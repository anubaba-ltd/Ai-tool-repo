<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title || appName %> - <%= appName %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet">
  <link href="/css/app.css" rel="stylesheet">
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark app-navbar">
  <div class="container-fluid px-4">
    <a class="navbar-brand fw-black d-flex align-items-center gap-2" href="/">
      <!-- <span class="brand-mark"><i class="fa-solid fa-shield-halved"></i></span> -->
      <span><%= appName %></span>
    </a>
    <% if (currentUser) { %>
    <div class="ms-auto d-flex align-items-center gap-2 gap-md-3">
      <div class="user-chip">
        <span class="avatar-dot"><%= (currentUser.name || 'U').charAt(0).toUpperCase() %></span>
        <span class="small fw-bold"><%= currentUser.name %> <span class="opacity-75">/ <%= currentUser.role %></span></span>
      </div>
      <form method="post" action="/logout" class="m-0">
        <button class="btn btn-light btn-sm px-3"><i class="fa-solid fa-arrow-right-from-bracket me-1"></i>Logout</button>
      </form>
    </div>
    <% } %>
  </div>
</nav>
<main class="app-shell container-fluid px-4 py-4 py-lg-5">
  <% if (success && success.length) { %>
    <div class="alert alert-success border-0 rounded-4 shadow-sm"><i class="fa-solid fa-circle-check me-2"></i><%= success[0] %></div>
  <% } %>
  <% if (error && error.length) { %>
    <div class="alert alert-danger border-0 rounded-4 shadow-sm"><i class="fa-solid fa-triangle-exclamation me-2"></i><%= error[0] %></div>
  <% } %>
  <%- body %>
</main>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/app.js"></script>
</body>
</html>
