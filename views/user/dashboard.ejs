<div class="page-toolbar">
  <div>
    <!-- <span class="kicker"><i class="fa-solid fa-table-cells-large"></i> Assigned access</span> -->
    <h2 class="page-title fw-black mb-1">Your Tools</h2>
    <p class="text-muted mb-0"><%= tools.length %> tool<%= tools.length===1?'':'s' %> available for your account.</p>
  </div>
</div>

<div class="row g-4">
  <% tools.forEach((t,i)=>{ %>
  <div class="col-xl-4 col-md-6">
    <div class="card tool-card p-4 h-100">
      <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
        <div class="d-flex align-items-center gap-3">
          <div class="icon-bubble"><i class="fa-solid fa-arrow-up-right-from-square"></i></div>
          <div>
            <h4 class="card-title fw-black mb-1"><%= t.name %></h4>
            <span class="badge badge-soft"><i class="fa-regular fa-clock me-1"></i><%= t.expiryHours %>h expiry</span>
          </div>
        </div>
      </div>
      <p class="text-muted"><%= t.description || 'No description added yet.' %></p>
      <div class="copy-box small d-none" id="inst<%= i %>"><%= t.instructions || t.accessNotes || '' %></div>
      <div class="d-grid gap-2 mt-auto">
        <button class="btn btn-outline-secondary" type="button" onclick="copyText('inst<%= i %>')"><i class="fa-solid fa-copy me-2"></i>Copy Access Text</button>
        <% if (t.extensionFile) { %>
          <a class="btn btn-outline-dark" href="/uploads/<%= t.extensionFile %>" download><i class="fa-solid fa-file-arrow-down me-2"></i>Download Tool Extension</a>
        <% } %>
        <a class="btn btn-primary" href="<%= t.url %>" target="_blank" onclick="trackTool('<%= t.id %>')"><i class="fa-solid fa-arrow-up-right-from-square me-2"></i>Open Tool</a>
      </div>
      <hr class="my-4">
      <div class="meta-line">
        <span class="meta-pill"><i class="fa-solid fa-hourglass-half"></i>Expires after <%= t.expiryHours %> hours</span>
      </div>
    </div>
  </div>
  <% }) %>
  <% if (!tools.length) { %>
  <div class="col-12">
    <div class="card empty-state">
      <i class="fa-solid fa-toolbox"></i>
      <h3 class="fw-black">No tools available</h3>
      <p class="text-muted mb-0">Ask admin to add tools for your account.</p>
    </div>
  </div>
  <% } %>
</div>
